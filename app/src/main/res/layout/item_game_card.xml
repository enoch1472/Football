<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_card"
    android:layout_marginBottom="16dp"
    android:elevation="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/game_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/badge_container"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/text_game_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Pickup game name #1" />

        <TextView
            android:id="@+id/text_game_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:text="Fri, Aug 21 at 7:00 pm" />

        <TextView
            android:id="@+id/text_game_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:text="BMO Soccer Center, Field 1" />

        <TextView
            android:id="@+id/text_game_host"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary_dark"
            android:textSize="14sp"
            android:layout_marginTop="2dp"
            android:text="Host: Bruno Fernandes" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/badge_container"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_badge_green"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/players_label"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/text_player_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:text="4/14" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_send_request"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_below="@id/badge_container"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_green"
        android:text="@string/send_request"
        android:textColor="@color/text_white"
        android:textSize="11sp"
        android:textAllCaps="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:minHeight="0dp"
        android:minWidth="0dp" />

</RelativeLayout>
